// VPS Reseller Directory & Management Platform (WHMCS Integrated)
// Rules:
// - All IDs are bigint (serialized as strings in JSON)
// - All monetary amounts are bigint in minor units (e.g. cents) + 3-letter ISO currency code

Table users {
  user_id bigint [pk, increment]
  name varchar(150) [not null]
  email varchar(255) [not null, unique]
  password_hash text [not null]
  phone varchar(50)
  profile_img text
  role varchar(30) [not null, default: 'staff', note: 'admin | staff']
  status boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table countries {
  country_id bigint [pk, increment]
  country_name varchar(100) [not null, unique]
  iso_code varchar(3) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table vendors {
  vendor_id bigint [pk, increment]
  vendor_name varchar(150) [not null]
  vendor_website text
  vendor_rating numeric(3,2) [not null, default: 0.00]
  vendor_sales_count integer [not null, default: 0]
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table vendor_packages {
  package_id bigint [pk, increment]
  vendor_id bigint [not null]
  country_id bigint [not null]
  package_name varchar(150) [not null]
  cpu_cores varchar(50)
  ram varchar(50) [not null]
  storage varchar(50) [not null]
  operating_system varchar(100) [not null]
  bandwidth varchar(50) [not null]
  dedicated_ip varchar(50) [not null]
  price_minor bigint [not null, note: 'Minor units, e.g. cents']
  currency char(3) [not null, default: 'USD']
  billing_cycle varchar(30) [not null, default: 'monthly']
  package_sales_count integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table display_packages {
  display_package_id bigint [pk, increment]
  whmcs_pid bigint [unique, note: 'Maps to WHMCS Product ID (tblproducts.id)']
  vendor_id bigint
  default_vendor_package_id bigint
  country_id bigint [not null]
  package_name varchar(150) [not null]
  cpu_cores varchar(50)
  ram varchar(50) [not null]
  storage varchar(50) [not null]
  operating_system varchar(100) [not null]
  bandwidth varchar(50) [not null]
  dedicated_ip varchar(50) [not null]
  price_minor bigint [not null, note: 'Retail price in minor units']
  currency char(3) [not null, default: 'USD']
  billing_cycle varchar(30) [not null, default: 'monthly']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table clients {
  client_id bigint [pk, increment]
  whmcs_client_id bigint [unique, note: 'Maps to WHMCS Client ID (tblclients.id)']
  client_name varchar(150) [not null]
  client_email varchar(255) [not null]
  client_phone varchar(50)
  company_name varchar(150)
  status varchar(30) [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table purchases {
  purchase_id bigint [pk, increment]
  whmcs_order_id bigint
  whmcs_service_id bigint [unique, note: 'Maps to WHMCS Hosting/Service ID (tblhosting.id)']
  whmcs_invoice_id bigint
  client_id bigint [not null]
  display_package_id bigint
  vendor_id bigint [note: 'Nullable until fulfilled by staff']
  package_id bigint [note: 'Nullable until fulfilled by staff']
  ip_address varchar(100)
  hostname varchar(255)
  status varchar(30) [not null, default: 'pending_fulfillment', note: 'pending_fulfillment | active | suspended | cancelled | refunded']
  sales_amount_minor bigint [not null]
  purchase_amount_minor bigint [not null, default: 0]
  processing_charges_minor bigint [not null, default: 0]
  profit_amount_minor bigint [not null, default: 0]
  currency char(3) [not null, default: 'USD']
  purchase_date timestamptz [not null, default: `now()`]
  due_date timestamptz
  billing_cycle varchar(30) [not null, default: 'monthly']
  payment_method varchar(60)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table refunds {
  refund_id bigint [pk, increment]
  purchase_id bigint [not null]
  client_id bigint [not null]
  vendor_id bigint
  display_package_id bigint
  refund_amount_minor bigint [not null]
  currency char(3) [not null, default: 'USD']
  whmcs_transaction_id varchar(100)
  reason text
  refund_date timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table expenses {
  expense_id bigint [pk, increment]
  vendor_id bigint
  expense_title varchar(150) [not null]
  expense_description text
  category varchar(50) [not null, default: 'general']
  expense_amount_minor bigint [not null]
  currency char(3) [not null, default: 'USD']
  expense_date timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table scripts {
  script_id bigint [pk, increment]
  script_name varchar(150) [not null]
  os_type varchar(50)
  script_content text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table message_email_templates {
  template_id bigint [pk, increment]
  template_name varchar(150) [not null]
  channel varchar(30) [not null, default: 'email', note: 'email | whatsapp | ticket']
  template_subject varchar(255)
  template_content text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table whmcs_sync_logs {
  sync_id bigint [pk, increment]
  source varchar(20) [not null, note: 'webhook | api_pull']
  event_type varchar(50) [not null]
  external_id varchar(100)
  payload jsonb [not null]
  status varchar(20) [not null, default: 'processed', note: 'processed | failed | ignored']
  error_message text
  created_at timestamptz [not null, default: `now()`]
}

Ref: vendors.vendor_id < vendor_packages.vendor_id
Ref: countries.country_id < vendor_packages.country_id
Ref: vendors.vendor_id < display_packages.vendor_id
Ref: vendor_packages.package_id < display_packages.default_vendor_package_id
Ref: countries.country_id < display_packages.country_id
Ref: clients.client_id < purchases.client_id
Ref: display_packages.display_package_id < purchases.display_package_id
Ref: vendors.vendor_id < purchases.vendor_id
Ref: vendor_packages.package_id < purchases.package_id
Ref: purchases.purchase_id < refunds.purchase_id
Ref: clients.client_id < refunds.client_id
Ref: vendors.vendor_id < refunds.vendor_id
Ref: display_packages.display_package_id < refunds.display_package_id
Ref: vendors.vendor_id < expenses.vendor_id
